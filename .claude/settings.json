{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Bash",
      "WebSearch",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:nextjs.org)",
      "WebFetch(domain:react.dev)",
      "WebFetch(domain:supabase.com)",
      "WebFetch(domain:vercel.com)",
      "WebFetch(domain:vitest.dev)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(vercel:*)",
      "Bash(supabase:*)",
      "Bash(npx supabase:*)",
      "Bash(bun add:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(gh:*)",
      "Edit(package.json)",
      "Edit(bun.lock)",
      "Edit(package-lock.json)",
      "Edit(.github/workflows/**)",
      "Write(.github/workflows/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)",
      "Edit(.claude/hooks/**)",
      "Write(.claude/hooks/**)",
      "WebFetch"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.production)",
      "Read(.env.test)",
      "Read(.env.*.local)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.development)",
      "Edit(.env.production)",
      "Edit(.env.test)",
      "Edit(.env.*.local)",
      "Edit(**/*.key)",
      "Edit(**/*.pem)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(.env.development)",
      "Write(.env.production)",
      "Write(.env.test)",
      "Write(.env.*.local)",
      "Write(**/*.key)",
      "Write(**/*.pem)",
      "Edit(.codex/**)",
      "Write(.codex/**)",
      "Edit(.gemini/**)",
      "Write(.gemini/**)",
      "Edit(.agents/**)",
      "Write(.agents/**)",
      "Edit(~/.claude/settings.json)",
      "Write(~/.claude/settings.json)",
      "Bash(sudo:*)",
      "Bash(ssh:*)",
      "Bash(chmod 777:*)",
      "Bash(rm -rf:*)",
      "Bash(*> /dev/*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gh",
        "~/.config/stripe",
        "~/.kube",
        "~/.docker",
        "~/.supabase",
        "~/Library/Application Support/com.vercel.cli",
        "~/.codex",
        "~/.gemini",
        "~/OhMyProject"
      ],
      "allowRead": ["."],
      "denyWrite": [
        ".env",
        ".env.local",
        ".env.development",
        ".env.production",
        ".env.test",
        ".claude/settings.json",
        ".claude/hooks",
        ".codex",
        ".gemini",
        ".agents"
      ],
      "allowWrite": [
        "~/.npm",
        "~/.bun/install/cache",
        "~/.cache"
      ]
    },
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "github.com",
        "api.github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "codeload.github.com",
        "fonts.googleapis.com",
        "fonts.gstatic.com",
        "*.supabase.co",
        "api.groq.com",
        "api.openai.com",
        "api.stripe.com",
        "api.resend.com",
        "*.upstash.io",
        "*.ingest.sentry.io",
        "*.ingest.us.sentry.io"
      ],
      "allowUnixSockets": [],
      "allowLocalBinding": true,
      "strictAllowlist": false
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-stop.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
